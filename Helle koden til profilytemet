  const item = (gathering: Gathering) => (
    <article className="admin-newsletter-item" key={gathering.id}>
      <div className="admin-newsletter-item-copy"><span className="label">{gathering.status === 'archived' ? 'Arkivert samling' : 'Kommende samling'}</span><h3>{fullTitle(gathering)}</h3><small>{dateLine(gathering) || 'Dato ikke satt'} · {placeLine(gathering) || 'Sted ikke satt'}</small></div>
      <div className="admin-newsletter-item-actions">
        <button className="admin-copy" disabled={busy} onClick={() => startEdit(gathering)}>Rediger</button>
        {gathering.status === 'archived' ? <button className="admin-copy" disabled={busy} onClick={() => setArchived(gathering, false)}>Gjenopprett</button> : <button className="admin-copy" disabled={busy} onClick={() => setArchived(gathering, true)}>Arkiver</button>}
        <button className="admin-delete" disabled={busy} onClick={() => remove(gathering)}>Slett</button>
      </div>
    </article>
  )

  return (
    <>
      <section className="admin-newsletter-archive">
        <div className="admin-newsletter-heading"><div><p className="eyebrow">Samlinger</p><h2>Samlingsoversikt<span>.</span></h2><p>Kommende: {active.length} · Arkivert: {archived.length}</p></div></div>
        {active.length === 0 ? <div className="newsletter-empty"><h3>Ingen kommende samlinger.</h3><p>Nye samlinger vises her og på alle profiler.</p></div> : <div className="admin-newsletter-list">{active.map(item)}</div>}
        {archived.length > 0 && <div className="admin-newsletter-archive-list"><h3>Arkiverte samlinger</h3><div className="admin-newsletter-list">{archived.map(item)}</div></div>}
      </section>
      <section className="admin-newsletter-composer" id="gathering-form">
        <p className="eyebrow">Samling</p>
        <h2>{editingId ? 'Rediger samling.' : 'Opprett ny samling.'}</h2>
        <p>Samlingen vises automatisk under «Kommende samlinger» på alle profiler, med samme oppsett som Sommerro-samlingen.</p>
        <label>Tittel<input value={draft.title} onChange={(event) => update('title', event.target.value)} placeholder="For eksempel: Førjulssamling" /></label>
        <label>Undertittel (kursiv)<input value={draft.titleAccent} onChange={(event) => update('titleAccent', event.target.value)} placeholder="For eksempel: på Sommerro" /></label>
        <label>Kort beskrivelse (oversikt)<textarea value={draft.summary} onChange={(event) => update('summary', event.target.value)} rows={3} /></label>
        <label>Full beskrivelse (detaljside)<textarea value={draft.description} onChange={(event) => update('description', event.target.value)} rows={5} /></label>
        <label>Bilder (første bilde er hovedbilde, maks 4)<input type="file" accept="image/*" multiple onChange={(event) => { void addImages(event.target.files); event.target.value = '' }} /></label>
        {draft.images.length > 0 && <div className="gathering-image-previews">{draft.images.map((image, index) => <div key={index}><img src={image} alt={`Bilde ${index + 1}`} /><button type="button" className="admin-delete" onClick={() => setDraft({ ...draft, images: draft.images.filter((_, i) => i !== index) })}>Fjern</button></div>)}</div>}
        <label>Dato<input type="date" value={draft.eventDate} onChange={(event) => update('eventDate', event.target.value)} /></label>
        <label>Klokkeslett<input type="time" value={draft.eventTime} onChange={(event) => update('eventTime', event.target.value)} /></label>
        <label>Sted<input value={draft.place} onChange={(event) => update('place', event.target.value)} placeholder="For eksempel: Sommerro" /></label>
        <label>Adresse<input value={draft.address} onChange={(event) => update('address', event.target.value)} placeholder="For eksempel: Oslo" /></label>
        <label>Oppmøte<input value={draft.meetingPoint} onChange={(event) => update('meetingPoint', event.target.value)} placeholder="For eksempel: Café Lucy i resepsjonen" /></label>
        <label>Praktisk informasjon<textarea value={draft.practicalInfo} onChange={(event) => update('practicalInfo', event.target.value)} rows={3} /></label>
        <label>Pris<input value={draft.price} onChange={(event) => update('price', event.target.value)} placeholder="For eksempel: 300–450 kr" /></label>
        <label>Påmeldingsfrist<input type="date" value={draft.deadline} onChange={(event) => update('deadline', event.target.value)} /></label>
        <label>Annen relevant informasjon<textarea value={draft.otherInfo} onChange={(event) => update('otherInfo', event.target.value)} rows={3} /></label>
        <div className="admin-edit-actions">
          <button className="button button--burgundy" disabled={busy} onClick={save}>{editingId ? 'Lagre endringer' : 'Publiser samling'}</button>
          {editingId && <button className="admin-cancel" onClick={() => { setEditingId(null); setDraft(emptyDraft) }}>Avbryt</button>}
        </div>
      </section>
    </>
  )
}

