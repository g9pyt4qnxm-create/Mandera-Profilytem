import { useState } from 'react'

export type Gathering = {
  id: number
  title: string
  titleAccent: string
  summary: string
  description: string
  images: string[]
  eventDate: string
  eventTime: string
  place: string
  address: string
  meetingPoint: string
  practicalInfo: string
  price: string
  deadline: string
  otherInfo: string
  status: 'active' | 'archived'
  createdAt: string
  archivedAt: string | null
}

type GatheringDraft = Omit<Gathering, 'id' | 'status' | 'createdAt' | 'archivedAt'>

const emptyDraft: GatheringDraft = { title: '', titleAccent: '', summary: '', description: '', images: [], eventDate: '', eventTime: '', place: '', address: '', meetingPoint: '', practicalInfo: '', price: '', deadline: '', otherInfo: '' }

const API = '/api/gatherings'

export async function fetchGatherings(): Promise<Gathering[]> {
  const response = await fetch(API)
  if (!response.ok) throw new Error('Kunne ikke hente samlinger')
  return response.json()
}

async function send(method: string, body?: unknown, query = '') {
  const response = await fetch(`${API}${query}`, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined })
  if (!response.ok) throw new Error('Lagring feilet')
}

export function formatDate(value: string) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value
  return new Date(`${value}T12:00:00`).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })
}

export function fullTitle(gathering: Gathering) {
  return [gathering.title, gathering.titleAccent].filter(Boolean).join(' ')
}

export function placeLine(gathering: Gathering) {
  return [gathering.place, gathering.address].filter(Boolean).join(', ')
}

export function dateLine(gathering: Gathering) {
  return [formatDate(gathering.eventDate), gathering.eventTime].filter(Boolean).join(' · ')
}

export function gatheringArchiveBody(gathering: Gathering) {
  const facts = [dateLine(gathering), placeLine(gathering), gathering.meetingPoint && `Oppmøte: ${gathering.meetingPoint}`, gathering.price && `Pris: ${gathering.price}`].filter(Boolean)
  const sections = [gathering.description || gathering.summary, gathering.practicalInfo && `Praktisk informasjon\n${gathering.practicalInfo}`, gathering.otherInfo && `Annen informasjon\n${gathering.otherInfo}`].filter(Boolean)
  return [facts.join('\n'), ...sections].filter(Boolean).join('\n\n')
}

async function compressImage(file: File) {
  const bitmap = await createImageBitmap(file)
  const scale = Math.min(1, 1400 / Math.max(bitmap.width, bitmap.height))
  const canvas = document.createElement('canvas')
  canvas.width = Math.max(1, Math.round(bitmap.width * scale))
  canvas.height = Math.max(1, Math.round(bitmap.height * scale))
  canvas.getContext('2d')?.drawImage(bitmap, 0, 0, canvas.width, canvas.height)
  bitmap.close()
  return canvas.toDataURL('image/jpeg', 0.75)
}

